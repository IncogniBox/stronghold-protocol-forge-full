{
 "id": "dossoles",
 "name": "多索雷斯",
 "version": "1.1.1",
 "author": "the Side Story mod",
 "license": "GPL-3.0-or-later",
 "notices": {
  "announcement": "notice/announcement.json"
 },
 "description": "「多索雷斯假日」故事集包：新增故事集盟约【多索雷斯】（bondType=SIDE_STORY，阈值 2 / 2 人（两档同为在场 2 名），由前置包 workshop/side-story 的故事集规则参与本局抽签与简报分区）。效果取自多索雷斯假日活动的「水蚀」机制：①【多索雷斯】干员的攻击范围视为特殊水地形，处在其上的【多索雷斯】干员攻击附带侵蚀损伤，处在其上的敌人移动与攻击速度降低；②敌人受到侵蚀损伤爆发时额外降低防御力，并在损伤爆发期间每 0.5 秒受到一次元素伤害。本包另含 4 名【多索雷斯】盟约干员（假日威龙陈 / 林 / 羽毛笔 / 龙舌兰）与 6 件「知名商品标志物」装备（多索雷斯游客章 / 奇科龙舌兰 / 奇科精品龙舌兰 / 安东龙舌兰 / 沙兹专业镀膜装置 / 翡翠庭院至臻，只能从龙舌兰的特质中获得）。",
 "gameVersion": "0.3.0",
 "combat": true,
 "stripDiyOverlaps": true,
 "server": {
  "battle": {
   "module": "battle/main.mjs"
  },
  "meta": {
   "module": "meta/main.mjs",
   "registers": [
    "garrison:DOS_LIN_PREP_FALLBACK",
    "garrison:DOS_TAKILA_GIFT_ITEM",
    "item:chess_item_ws_dos_tourbadge",
    "item:chess_item_ws_dos_chico",
    "item:chess_item_ws_dos_chico_premium",
    "item:chess_item_ws_dos_anton",
    "item:chess_item_ws_dos_coating",
    "effect:mod_dos_premium"
   ]
  }
 },
